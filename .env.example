# ---- Supabase (public) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase (server only — never expose to the browser) ----
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI (server only) ----
ANTHROPIC_API_KEY=
# Speech-to-text provider used for interview transcription
OPENAI_API_KEY=

# ---- Maps (client) ----

# ---- Demo seed script ----
SEED_DEMO_PASSWORD=forensibus-demo-1234

# ---- Local convenience ----
# Set to 1 to list the demo accounts on the sign-in page. Dev builds only —
# a production build strips the panel regardless of this value.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=1

# ---- Self-service registration (/signup) ----
# An account grants nothing on its own, so registration also places the new user
# in an organisation with a role. While this is on, anyone who reaches /signup
# gets SIGNUP_DEFAULT_ROLE inside SIGNUP_ORG_SLUG and can see that org's cases.
# SIGNUP_ENABLED=false            close registration entirely
# SIGNUP_ORG_SLUG=northgate       required once more than one org exists
# SIGNUP_DEFAULT_ROLE=read_only   default is investigator

# ---- map --------------------------------------------------------------------
# CARTO Basemaps key, from carto.com/basemaps/apikey. Public by necessity: the
# browser fetches the tiles, so it travels in the URL whatever you do. Protect
# it with a domain restriction on the CARTO dashboard rather than by hiding it.
# Leave it unset and the map still works — every tile just carries a watermark.
NEXT_PUBLIC_CARTO_KEY=
